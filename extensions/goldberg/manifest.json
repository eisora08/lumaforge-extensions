{
  "schemaVersion": 1,
  "id": "goldberg",
  "name": "goldberg",
  "displayName": "Goldberg Emulator",
  "description": "Steam client emulator for offline play",
  "summary": "Steam emulator for running games without Steam client",
  "version": "0.4.0",
  "author": "Detonator01",
  "repository": "https://github.com/Detonator01/Goldberg_Emulator",
  "license": "GPL-3.0",
  "categories": ["steam", "emulation"],
  "tags": ["goldberg", "emulator", "offline"],
  "managedFiles": [
    {
      "path": "steamclient.dll",
      "required": false,
      "replaceStrategy": "always",
      "backupStrategy": "rename",
      "validationStrategy": "exists",
      "isExecutable": true
    },
    {
      "path": "steamclient64.dll",
      "required": false,
      "replaceStrategy": "always",
      "backupStrategy": "rename",
      "validationStrategy": "exists",
      "isExecutable": true
    }
  ],
  "metadata": {
    "type": "tool",
    "surfaces": ["tools"],
    "toolConfig": {
      "target": "game-folder",
      "files": [
        { "source": "steamclient.dll", "target": "steamclient.dll" },
        { "source": "steamclient64.dll", "target": "steamclient64.dll" }
      ],
      "backup": true,
      "backupSuffix": ".bak"
    }
  },
  "permissions": [
    { "id": "filesystem.write", "reason": "Copy files to game folder" },
    { "id": "filesystem.delete", "reason": "Remove files on revert" }
  ],
  "releaseProvider": {
    "provider": "github",
    "config": {
      "owner": "Detonator01",
      "repo": "Goldberg_Emulator",
      "assetPattern": "*.zip",
      "tagPattern": "*"
    }
  }
}
